{
  "name": "@itslil/micromark",
  "version": "4.0.3",
  "description": "micromark markdown compiler reimplemented in LilScript",
  "keywords": [
    "micromark",
    "markdown",
    "commonmark",
    "compiler",
    "lilscript",
    "itslil"
  ],
  "homepage": "https://yeargun.github.io/micromarklil/",
  "bugs": "https://github.com/yeargun/micromarklil/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeargun/micromarklil.git"
  },
  "license": "MIT",
  "author": "yeargun",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/micromark.cjs",
  "module": "./dist/micromark.esm.js",
  "types": "./dist/micromark.d.ts",
  "unpkg": "./dist/micromark.umd.js",
  "jsdelivr": "./dist/micromark.umd.js",
  "exports": {
    ".": {
      "types": "./dist/micromark.d.ts",
      "import": "./dist/micromark.esm.js",
      "require": "./dist/micromark.cjs",
      "default": "./dist/micromark.esm.js"
    },
    "./stream": {
      "types": "./dist/micromark.stream.d.ts",
      "import": "./dist/micromark.stream.js",
      "require": "./dist/micromark.stream.cjs",
      "default": "./dist/micromark.stream.js"
    },
    "./closed": "./dist/micromark.closed.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist/micromark.esm.js",
    "dist/micromark.cjs",
    "dist/micromark.umd.js",
    "dist/micromark.closed.js",
    "dist/micromark.stream.js",
    "dist/micromark.stream.cjs",
    "dist/micromark.stream.d.ts",
    "dist/micromark.d.ts",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs --compile",
    "build:site": "node scripts/build-site.mjs",
    "test": "node --test test/official/index.js test/public-api.test.mjs test/stream-api.test.mjs",
    "check:types": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 test/types.test.ts",
    "check:site": "npm run build:site && node --test test/site.test.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "npm test && npm run check:types && npm run check:pack && npm run check:site"
  },
  "dependencies": {
    "@types/node": "^22.0.0",
    "micromark-util-types": "^2.0.0"
  },
  "devDependencies": {
    "character-entities": "^2.0.2",
    "commonmark.json": "^0.31.0",
    "concat-stream": "^2.0.0",
    "esbuild": "0.28.1",
    "micromark-extension-gfm": "^3.0.0",
    "typescript": "5.9.3"
  }
}
