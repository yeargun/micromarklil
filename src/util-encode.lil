JsValue characterReferences = object { "\"": "quot", "&": "amp", "<": "lt", ">": "gt" };

Regex dangerousCharacters = new Regex("[\"&<>]", "g");

export string encode(string value) {
  return JS.assume(JS.call(JS.get(value, "replace"), value, dangerousCharacters, JS.method1((JsValue _s, JsValue character) => {
    return "&" + characterReferences[character] + ";";
  })));
}
