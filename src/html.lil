import { Opts } from "./options.lil";
import { count, at, escapeHtml, safeUrl } from "./util.lil";

string nodeType(JsValue node) {
  return JS.string(node["type"]);
}

string nodeStr(JsValue node, string key) {
  JsValue value = node[key];
  if (JS.isUndefined(value) || JS.isNullish(value)) {
    return "";
  }
  return JS.string(value);
}

bool nodeBool(JsValue node, string key) {
  JsValue value = node[key];
  if (JS.isUndefined(value) || JS.isNullish(value)) {
    return false;
  }
  return value.truthy();
}

int nodeInt(JsValue node, string key, int fallback) {
  JsValue value = node[key];
  if (JS.isUndefined(value) || JS.isNullish(value)) {
    return fallback;
  }
  return JS.number(value).toInt();
}

JsValue nodeKids(JsValue node) {
  JsValue children = node["children"];
  if (JS.isUndefined(children) || JS.isNullish(children)) {
    return JS.array();
  }
  return children;
}

bool hasKids(JsValue node) {
  JsValue children = node["children"];
  return !(JS.isUndefined(children) || JS.isNullish(children));
}

string renderChildren(JsValue children, Opts opt, bool tight) {
  string out = "";
  int n = count(children);
  int i = 0;
  while (i < n) {
    out = out + renderNode(at(children, i), opt, tight);
    i = i + 1;
  }
  return out;
}

string attr(string name, string value) {
  return " " + name + "=\"" + escapeHtml(value) + "\"";
}

string checkbox(bool checked) {
  string html = "<input type=\"checkbox\" disabled=\"\"";
  if (checked) {
    html = html + " checked=\"\"";
  }
  return html + "> ";
}

string renderParagraph(JsValue node, Opts opt, bool tight) {
  string inner = renderChildren(nodeKids(node), opt, false);
  if (tight) {
    return inner;
  }
  return "<p>" + inner + "</p>\n";
}

string renderHeading(JsValue node, Opts opt) {
  int depth = nodeInt(node, "depth", 1);
  if (depth < 1) {
    depth = 1;
  }
  if (depth > 6) {
    depth = 6;
  }
  string tag = "h" + depth.toString();
  return "<" + tag + ">" + renderChildren(nodeKids(node), opt, false) + "</" + tag + ">\n";
}

string renderCode(JsValue node) {
  string value = nodeStr(node, "value");
  string lang = nodeStr(node, "lang");
  string open = "<pre><code";
  if (lang.length > 0) {
    open = open + " class=\"language-" + escapeHtml(lang) + "\"";
  }
  open = open + ">";
  string body = escapeHtml(value);
  if (body.length > 0 && !body.endsWith("\n")) {
    body = body + "\n";
  }
  return open + body + "</code></pre>\n";
}

string renderQuote(JsValue node, Opts opt) {
  return "<blockquote>\n" + renderChildren(nodeKids(node), opt, false) + "</blockquote>\n";
}

string renderList(JsValue node, Opts opt) {
  bool ordered = nodeBool(node, "ordered");
  bool spread = nodeBool(node, "spread");
  string tag = "ul";
  string open = "<ul>\n";
  if (ordered) {
    tag = "ol";
    int start = nodeInt(node, "start", 1);
    if (start != 1) {
      open = "<ol start=\"" + start.toString() + "\">\n";
    } else {
      open = "<ol>\n";
    }
  }
  string inner = "";
  JsValue items = nodeKids(node);
  int n = count(items);
  int i = 0;
  while (i < n) {
    inner = inner + renderItem(at(items, i), opt, !spread);
    i = i + 1;
  }
  return open + inner + "</" + tag + ">\n";
}

string renderItem(JsValue node, Opts opt, bool tight) {
  string prefix = "";
  JsValue checked = node["checked"];
  if (!(JS.isUndefined(checked) || JS.isNullish(checked))) {
    prefix = checkbox(checked.truthy());
  }
  bool itemTight = tight && !nodeBool(node, "spread");
  string inner = "";
  JsValue children = nodeKids(node);
  int n = count(children);
  int i = 0;
  while (i < n) {
    JsValue child = at(children, i);
    string typ = nodeType(child);
    if (typ == "paragraph" && itemTight) {
      inner = inner + prefix + renderChildren(nodeKids(child), opt, false);
      prefix = "";
      if (i + 1 < n) {
        inner = inner + "\n";
      }
    } else {
      if (prefix.length > 0 && typ != "paragraph") {
        inner = inner + prefix;
        prefix = "";
      }
      inner = inner + renderNode(child, opt, itemTight);
    }
    i = i + 1;
  }
  if (prefix.length > 0) {
    inner = prefix + inner;
  }
  return "<li>" + inner + "</li>\n";
}

string renderLink(JsValue node, Opts opt) {
  string href = safeUrl(nodeStr(node, "url"));
  string title = nodeStr(node, "title");
  string html = "<a" + attr("href", href);
  if (title.length > 0) {
    html = html + attr("title", title);
  }
  return html + ">" + renderChildren(nodeKids(node), opt, false) + "</a>";
}

string renderImage(JsValue node) {
  string src = safeUrl(nodeStr(node, "src"));
  if (src.length == 0) {
    src = safeUrl(nodeStr(node, "url"));
  }
  string alt = nodeStr(node, "alt");
  string title = nodeStr(node, "title");
  string html = "<img" + attr("src", src) + attr("alt", alt);
  if (title.length > 0) {
    html = html + attr("title", title);
  }
  return html + ">";
}

string alignName(JsValue align, int i) {
  if (JS.isUndefined(align) || JS.isNullish(align) || !JS.isArray(align)) {
    return "";
  }
  if (i >= count(align)) {
    return "";
  }
  JsValue cell = at(align, i);
  if (JS.isUndefined(cell) || JS.isNullish(cell)) {
    return "";
  }
  return JS.string(cell);
}

string renderCell(JsValue node, Opts opt, string tag, string align) {
  string open = "<" + tag;
  if (align.length > 0) {
    open = open + attr("align", align);
  }
  return open + ">" + renderChildren(nodeKids(node), opt, false) + "</" + tag + ">\n";
}

string renderTable(JsValue node, Opts opt) {
  JsValue rows = nodeKids(node);
  JsValue align = node["align"];
  int n = count(rows);
  string out = "<table>\n";
  if (n > 0) {
    out = out + "<thead>\n<tr>\n";
    JsValue header = nodeKids(at(rows, 0));
    int cells = count(header);
    int i = 0;
    while (i < cells) {
      out = out + renderCell(at(header, i), opt, "th", alignName(align, i));
      i = i + 1;
    }
    out = out + "</tr>\n</thead>\n";
  }
  if (n > 1) {
    out = out + "<tbody>\n";
    int r = 1;
    while (r < n) {
      out = out + "<tr>\n";
      JsValue row = nodeKids(at(rows, r));
      int cells = count(row);
      int i = 0;
      while (i < cells) {
        out = out + renderCell(at(row, i), opt, "td", alignName(align, i));
        i = i + 1;
      }
      out = out + "</tr>\n";
      r = r + 1;
    }
    out = out + "</tbody>\n";
  }
  return out + "</table>\n";
}

string renderHtml(JsValue node, Opts opt) {
  string value = nodeStr(node, "value");
  if (opt.allowDangerousHtml) {
    return value;
  }
  return escapeHtml(value);
}

string renderText(JsValue node) {
  return escapeHtml(nodeStr(node, "value"));
}

string renderNode(JsValue node, Opts opt, bool tight) {
  string typ = nodeType(node);
  if (typ == "root") {
    return renderChildren(nodeKids(node), opt, false);
  }
  if (typ == "paragraph") {
    return renderParagraph(node, opt, tight);
  }
  if (typ == "heading") {
    return renderHeading(node, opt);
  }
  if (typ == "thematicBreak") {
    return "<hr>\n";
  }
  if (typ == "blockquote") {
    return renderQuote(node, opt);
  }
  if (typ == "list") {
    return renderList(node, opt);
  }
  if (typ == "listItem") {
    return renderItem(node, opt, tight);
  }
  if (typ == "code") {
    return renderCode(node);
  }
  if (typ == "inlineCode") {
    return "<code>" + escapeHtml(nodeStr(node, "value")) + "</code>";
  }
  if (typ == "html") {
    return renderHtml(node, opt);
  }
  if (typ == "definition") {
    return "";
  }
  if (typ == "text") {
    return renderText(node);
  }
  if (typ == "emphasis") {
    return "<em>" + renderChildren(nodeKids(node), opt, false) + "</em>";
  }
  if (typ == "strong") {
    return "<strong>" + renderChildren(nodeKids(node), opt, false) + "</strong>";
  }
  if (typ == "delete") {
    return "<del>" + renderChildren(nodeKids(node), opt, false) + "</del>";
  }
  if (typ == "break") {
    return "<br>\n";
  }
  if (typ == "link") {
    return renderLink(node, opt);
  }
  if (typ == "image") {
    return renderImage(node);
  }
  if (typ == "linkReference") {
    return renderChildren(nodeKids(node), opt, false);
  }
  if (typ == "imageReference") {
    return escapeHtml(nodeStr(node, "alt"));
  }
  if (typ == "table") {
    return renderTable(node, opt);
  }
  if (typ == "tableRow") {
    return "";
  }
  if (typ == "tableCell") {
    return renderChildren(nodeKids(node), opt, false);
  }
  if (typ == "inlineMath") {
    return "<code class=\"math-inline\">" + escapeHtml(nodeStr(node, "value")) + "</code>";
  }
  if (typ == "math") {
    return "<pre class=\"math-display\"><code>" + escapeHtml(nodeStr(node, "value")) + "</code></pre>\n";
  }
  if (hasKids(node)) {
    return renderChildren(nodeKids(node), opt, tight);
  }
  return escapeHtml(nodeStr(node, "value"));
}

export string renderTree(JsValue tree, Opts opt) {
  return renderNode(tree, opt, false);
}
