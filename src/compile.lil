Regex protocolSource = new Regex("^https?$", "i");

void prepareList(JsValue slice) {
  int length = arrLen(slice);
  int index = 0;
  int containerBalance = 0;
  bool loose = false;
  bool atMarker = false;
  while (true) {
    index = index + 1;
    if (index >= length) {
      break;
    }
    JsValue event = slice[index];
    if (objGet(event[1], "_container").truthy()) {
      atMarker = false;
      if (event[0] == "enter") {
        containerBalance = containerBalance + 1;
      } else {
        containerBalance = containerBalance - 1;
      }
    } else if (objGet(event[1], "type") == tListItemPrefix) {
      if (event[0] == "exit") {
        atMarker = true;
      }
    } else if (objGet(event[1], "type") == tLinePrefix) {
    } else if (objGet(event[1], "type") == tLineEndingBlank) {
      if (event[0] == "enter" && containerBalance == 0) {
        if (atMarker) {
          atMarker = false;
        } else {
          loose = true;
        }
      }
    } else {
      atMarker = false;
    }
  }
  JS.set(slice[0][1], "_loose", loose);
}

T lastOf<T>(T[] list) {
  return list[list.length - 1];
}

