// Only ever a string in the buffers upstream reads back; `raw`/`tag` push what they are given.
string textOf(JsValue value) {
  return JS.assume(value);
}

T lastOf<T>(T[] list) {
  return list[list.length - 1];
}

void prepareList(JsValue slice) {
  float containerBalance = 0;
  bool loose = false;
  bool atMarker = false;
  for (float index = 1; index < slice.length; index++) {
    JsValue event = slice[index];
    JsValue token = event[1];
    if (token["_container"].truthy()) {
      atMarker = false;
      if (event[0] == "enter") {
        containerBalance++;
      } else {
        containerBalance--;
      }
    } else if (token["type"] == "listItemPrefix") {
      if (event[0] == "exit") {
        atMarker = true;
      }
    } else if (token["type"] == "lineEndingBlank") {
      if (event[0] == "enter" && containerBalance == 0) {
        if (atMarker) {
          atMarker = false;
        } else {
          loose = true;
        }
      }
    } else if (token["type"] != "linePrefix") {
      atMarker = false;
    }
  }
  slice[0][1]["_loose"] = loose;
}

