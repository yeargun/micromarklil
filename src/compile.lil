        if (event[0] == "enter") {
          listStack.push(index);
        } else {
          prepareList(JS.call(events["slice"], events, listStack.pop(), index));
        }
      }
      if (type == "definition") {
        if (event[0] == "enter") {
          body = pushAll(body, JS.call(events["slice"], events, start, index));
          start = index;
        } else {
          head = pushAll(head, JS.call(events["slice"], events, start, index + 1));
          start = index + 1;
        }
      }
    }
    head = pushAll(head, body);
    head = pushAll(head, JS.call(events["slice"], events, start));
    if (handlers["enter"]["null"].truthy()) {
      JS.call(handlers["enter"]["null"], context);
    }
    for (float index = 0; index < events.length; index++) {
      JsValue event = head[index];
      JsValue handles = handlers[event[0]];
      JsValue kind = event[1]["type"];
      JsValue handle = handles[kind];
      if (hasOwn(handles, kind) && handle.truthy()) {
        JS.call(handle, JS.call(Object["assign"], Object, JS.object("sliceSerialize", event[2]["sliceSerialize"]), context), event[1]);
      }
    }
    if (handlers["exit"]["null"].truthy()) {
      JS.call(handlers["exit"]["null"], context);
    }
    JsValue result = buffers[0];
    return JS.call(result["join"], result, "");
  });
}
