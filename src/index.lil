import { compile } from "./compile.lil";
import { parse } from "./parse.lil";
import { postprocess } from "./postprocess.lil";
import { preprocess } from "./preprocess.lil";

export { compile, parse, postprocess, preprocess };

extern class Tokenizer {
  JsValue write(JsValue chunks);
}

extern class Parser {
  Tokenizer document();
}

Parser parser(JsValue options) {
  return JS.assume(parse(options));
}

export JsValue micromark(JsValue value, JsValue encoding, JsValue options) {
  if (!(encoding is string)) {
    options = encoding;
    encoding = JS.undefined();
  }
  return JS.call(compile(options), JS.undefined(), postprocess(parser(options).document().write(JS.call(preprocess(), JS.undefined(), value, encoding, true))));
}
