import { compile } from "./compile.lil";
import { parse } from "./parse.lil";
import { postprocess } from "./postprocess.lil";
import { preprocess } from "./preprocess.lil";

extern JsValue EventEmitter;
extern JsValue Error;

extern class Tokenizer {
  JsValue write;
}

extern class Parser {
  Tokenizer document();
}

// What `pipe` writes to and listens on: a Node.js writable stream or any `EventEmitter` like it.
extern class Destination {
  JsValue writable;
  JsValue _isStdio;
  JsValue write(JsValue chunk);
  JsValue end;
  JsValue on(JsValue name, JsValue listener);
  JsValue emit(JsValue name, JsValue value);
  JsValue removeListener(JsValue name, JsValue listener);
}

extern class Emitter {
  JsValue end;
  JsValue pipe;
  JsValue readable;
  JsValue writable;
  JsValue write;
  JsValue on(JsValue name, JsValue listener);
  JsValue emit(JsValue name, JsValue value);
  JsValue removeListener(JsValue name, JsValue listener);
  JsValue listenerCount(JsValue name);
}

Parser parser(JsValue options) {
  return JS.assume(parse(options));
}

export JsValue stream(JsValue options) {
  JsValue prep = preprocess();
  JsValue tokenize = parser(options).document().write;
  JsValue comp = compile(options);
  bool ended = false;
  JsValue emitterValue = JS.construct(EventEmitter);
  Emitter emitter = JS.assume(emitterValue);

  JsValue write = JS.method3((JsValue _self, JsValue chunk, JsValue encoding, JsValue callback) => {
    if (JS.typeOf(encoding) == "function") {
      callback = encoding;
      encoding = JS.undefined();
    }
    if (ended) {
      throw JS.construct(Error, "Did not expect `write` after `end`");
    }
    JsValue value = chunk;
    if (!value.truthy()) {
      value = "";
    }
    JS.call(tokenize, JS.undefined(), JS.call(prep, JS.undefined(), value, encoding));
    if (callback.truthy()) {
      JS.call(callback, JS.undefined());
    }
    return true;
  });

  JsValue end = JS.method3((JsValue _self, JsValue chunk, JsValue encoding, JsValue callback) => {
    if (JS.typeOf(chunk) == "function") {
      encoding = chunk;
      chunk = JS.undefined();
    }
    if (JS.typeOf(encoding) == "function") {
      callback = encoding;
      encoding = JS.undefined();
    }
    JS.call(write, JS.undefined(), chunk, encoding, callback);
    emitter.emit("data", JS.call(comp, JS.undefined(), postprocess(JS.call(tokenize, JS.undefined(), JS.call(prep, JS.undefined(), "", encoding, true)))));
    JS.call(emitterValue["emit"], emitterValue, "end");
    ended = true;
    return true;
  });

  JsValue pipe = JS.method2((JsValue _self, JsValue target, JsValue pipeOptions) => {
    Destination destination = JS.assume(target);
    JsValue onerror = JS.undefined();
    JsValue ondata = JS.method1((JsValue _s, JsValue chunk) => {
      if (destination.writable.truthy()) {
        destination.write(chunk);
      }
      return JS.undefined();
    });
    JsValue onend = JS.method0((JsValue _s) => {
      if (destination.end.truthy()) {
        JS.call(destination.end, destination);
      }
      return JS.undefined();
    });
    JsValue cleanup = JS.method0((JsValue _s) => {
      emitter.removeListener("data", ondata);
      emitter.removeListener("end", onend);
      emitter.removeListener("error", onerror);
      emitter.removeListener("end", cleanup);
      emitter.removeListener("close", cleanup);
      destination.removeListener("error", onerror);
      destination.removeListener("close", cleanup);
      return JS.undefined();
    });
    onerror = JS.method1((JsValue _s, JsValue error) => {
      JS.call(cleanup, JS.undefined());
      if (!emitter.listenerCount("error").truthy()) {
        throw error;
      }
      return JS.undefined();
    });
    emitter.on("data", ondata);
    emitter.on("error", onerror);
    emitter.on("end", cleanup);
    emitter.on("close", cleanup);
    if (!destination._isStdio.truthy() && (!pipeOptions.truthy() || pipeOptions["end"] != false)) {
      emitter.on("end", onend);
    }
    destination.on("error", onerror);
    destination.on("close", cleanup);
    destination.emit("pipe", emitter);
    return target;
  });

  emitter.end = end;
  emitter.pipe = pipe;
  emitter.readable = true;
  emitter.writable = true;
  emitter.write = write;
  return emitterValue;
}
