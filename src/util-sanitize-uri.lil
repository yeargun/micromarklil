import { asciiAlphanumeric } from "./util-character.lil";
import { encode } from "./util-encode.lil";

extern JsValue String;
extern JsValue encodeURIComponent;

Regex safeAscii = new Regex("[!#$&-;=?-Z_a-z~]", "");

export string normalizeUri(string value) {
  string result = "";
  int start = 0;
  int skip = 0;
  for (int index = 0; index < value.length; index++) {
    int code = value.charCodeAt(index);
    string replace = "";
    if (code == 37 && asciiAlphanumeric(value.charCodeAt(index + 1)) && asciiAlphanumeric(value.charCodeAt(index + 2))) {
      skip = 2;
    } else if (code < 128) {
      string character = JS.assume(JS.call(String["fromCharCode"], String, code));
      if (!safeAscii.test(character)) {
        replace = character;
      }
    } else if (code > 55295 && code < 57344) {
      int next = value.charCodeAt(index + 1);
      if (code < 56320 && next > 56319 && next < 57344) {
        replace = JS.assume(JS.call(String["fromCharCode"], String, code, next));
        skip = 1;
      } else {
        replace = "�";
      }
    } else {
      replace = JS.assume(JS.call(String["fromCharCode"], String, code));
    }
    if (replace.length > 0) {
      result = result + value.slice(start, index) + JS.call(encodeURIComponent, JS.undefined(), replace);
      start = index + skip + 1;
    }
    if (skip > 0) {
      index = index + skip;
      skip = 0;
    }
  }
  return result + value.slice(start);
}

export string sanitizeUri(JsValue url, JsValue protocol) {
  JsValue raw = url;
  if (!raw.truthy()) {
    raw = "";
  }
  string value = encode(normalizeUri(JS.assume(raw)));
  if (!protocol.truthy()) {
    return value;
  }
  int colon = value.indexOf(":");
  int questionMark = value.indexOf("?");
  int numberSign = value.indexOf("#");
  int slash = value.indexOf("/");
  if (
    colon < 0 ||
    (slash > -1 && colon > slash) ||
    (questionMark > -1 && colon > questionMark) ||
    (numberSign > -1 && colon > numberSign) ||
    JS.call(protocol["test"], protocol, value.slice(0, colon)).truthy()
  ) {
    return value;
  }
  return "";
}
